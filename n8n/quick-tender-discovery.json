{
  "name": "Quick Tender - Automated Discovery & Matching",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.QUICK_TENDER_API_URL || 'https://quicktender.co.ke' }}/api/discover-tenders",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.CRON_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "sourceIds",
              "value": "tenders-kenya,tendersinfo,tendersontime,gaa"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "trigger-discovery",
      "name": "Run Discovery Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-new-matches",
              "leftValue": "={{ $json.totals.inserted }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-new-matches",
      "name": "New Tenders Inserted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [620, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.africastalking.com/version1/messaging",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apiKey",
              "value": "={{ $env.AFRICASTALKING_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $env.AFRICASTALKING_USERNAME || 'sandbox' }}"
            },
            {
              "name": "to",
              "value": "={{ $env.ADMIN_PHONE_NUMBER }}"
            },
            {
              "name": "message",
              "value": "=Quick Tender Alert: {{ $json.totals.inserted }} new high-match tenders discovered across {{ $json.sources.length }} sources. Log in to your dashboard to review bids."
            }
          ]
        }
      },
      "id": "send-sms-alert",
      "name": "Send SMS / WhatsApp Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "log-no-new",
      "name": "Log (No New Matches)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, 420]
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Run Discovery Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Discovery Pipeline": {
      "main": [
        [
          {
            "node": "New Tenders Inserted?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New Tenders Inserted?": {
      "main": [
        [
          {
            "node": "Send SMS / WhatsApp Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log (No New Matches)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
