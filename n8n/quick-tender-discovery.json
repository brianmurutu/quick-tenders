{
  "name": "Quick Tender - Automated Discovery & Matching",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "trigger-discovery",
      "name": "Run Discovery Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        300
      ],
      "parameters": {
        "url": "https://quicktenders.co.ke/api/cron/discover-tenders?sources=tenders-kenya,tendersinfo,tendersontime,gaa",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 3b35f05c0c4df5e634732c35159fc5c9cdde6907b6bb64974198ae1250b1697f"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "check-new-matches",
      "name": "New Tenders Inserted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        620,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-new-matches",
              "leftValue": "={{ $json.totals.inserted }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "trigger-drafting",
      "name": "Auto-Draft Bid Documents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "url": "https://quicktenders.co.ke/api/cron/draft-documents",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 3b35f05c0c4df5e634732c35159fc5c9cdde6907b6bb64974198ae1250b1697f"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "send-sms-alert",
      "name": "Send SMS / WhatsApp Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sms.textsms.co.ke/api/services/sendsms/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"apikey\":\"746ae40c04a727bf224b33e1e3b3e0d4\",\"partnerID\":\"15007\",\"message\":\"Quick Tender Alert: New tenders matched and proposals drafted. Log into dashboard: https://quicktenders.co.ke/dashboard\",\"shortcode\":\"TextSMS\",\"mobile\":\"254712623941\"}"
      }
    },
    {
      "id": "log-no-new",
      "name": "Log (No New Matches)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        420
      ],
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "webhook-trigger",
      "name": "Dashboard Webhook Trigger",
      "webhookId": "quicktender-discovery-hook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        480
      ],
      "parameters": {
        "path": "quicktender-discovery",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Run Discovery Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Discovery Pipeline": {
      "main": [
        [
          {
            "node": "New Tenders Inserted?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New Tenders Inserted?": {
      "main": [
        [
          {
            "node": "Auto-Draft Bid Documents",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log (No New Matches)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auto-Draft Bid Documents": {
      "main": [
        [
          {
            "node": "Send SMS / WhatsApp Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dashboard Webhook Trigger": {
      "main": [
        [
          {
            "node": "Run Discovery Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  }
}
