# Supabase project settings, found under Project Settings > API in the
# dashboard. Copy this file to .env.local and fill in the real values.
# .env.local is gitignored; this file is not.
#
# Both are safe to expose to the browser: the anon key is a public credential
# and row level security is what keeps tenants apart.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin of this deployment, used to build the email confirmation
# redirect (SITE_URL + /auth/callback). Add the same value to the Supabase
# project Redirect URLs allow list under Authentication > URL Configuration,
# or confirmation links will be rejected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Tender discovery job (app/api/cron/discover-tenders)
# ---------------------------------------------------------------------------
# Server side only. None of these carry a NEXT_PUBLIC_ prefix, so none of them
# reach the browser. Keep it that way.

# Shared secret the scheduler presents, as "Authorization: Bearer <secret>" or
# "X-Cron-Secret: <secret>". The endpoint refuses every request when this is
# unset, so it fails closed rather than open. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Service role key, from Project Settings > API. Bypasses row level security,
# which the job needs because it reads every company and writes matches for all
# of them. Never expose this to a browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used to score tenders against each company profile.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Minimum match_score to store, 0 to 100. Defaults to 60.
# TENDER_MATCH_THRESHOLD=60

# Optional. Comma separated source ids to run. Unset means every real source,
# plus "mock" outside production. Ids: ppip, county-nairobi, county-kiambu,
# county-nakuru, mock.
# TENDER_SOURCES=ppip,mock

# PPIP (tenders.go.ke) is a CSV import, not a scraper: the portal renders its
# listings client side, so there is no reliable markup to parse. Point one of
# these at an export. See lib/tender-sources/ppip.ts for the column format.
# PPIP_CSV_PATH=./data/ppip-export.csv
# PPIP_CSV_URL=

# Nakuru County ships disabled: its REST API is public and permitted, but the
# tender notices were not found in posts or media. Confirm the right collection
# before turning this on.
# TENDER_SOURCE_COUNTY_NAKURU=false


# ---------------------------------------------------------------------------
# Bid document drafting and notification (app/api/cron/draft-documents)
# ---------------------------------------------------------------------------
# Reuses CRON_SECRET, SUPABASE_SERVICE_ROLE_KEY and ANTHROPIC_API_KEY above.
# Documents go to the private "tender-documents" Storage bucket, created by
# migration 0006.

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. The domain has to be verified in Resend first, or sends are
# rejected. A display name is fine: "Quick Tenders <tenders@yourdomain.com>"
RESEND_FROM_EMAIL=

# The review link in the email is built from NEXT_PUBLIC_SITE_URL above, as
# <site url>/dashboard/tenders/<id>. Set NEXT_PUBLIC_SITE_URL to the real origin
# in production or the emails will link to localhost.
