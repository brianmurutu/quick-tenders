# Supabase project settings — Project Settings > API in the dashboard.
# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored; this file is not.
#
# Both are safe to expose to the browser: the anon key is a public credential
# and row level security is what keeps tenants apart.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
