# Supabase project settings, found under Project Settings > API in the
# dashboard. Copy this file to .env.local and fill in the real values.
# .env.local is gitignored; this file is not.
#
# Both are safe to expose to the browser: the anon key is a public credential
# and row level security is what keeps tenants apart.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin of this deployment, used to build the email confirmation
# redirect (SITE_URL + /auth/callback). Add the same value to the Supabase
# project Redirect URLs allow list under Authentication > URL Configuration,
# or confirmation links will be rejected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# AI provider, for tender matching and bid drafting (lib/ai.ts)
# ---------------------------------------------------------------------------
# Both providers speak the OpenAI Chat Completions shape, so switching is a
# matter of which key is set. When AI_PROVIDER is unset, the first provider with
# a key present wins, and Groq is checked first.
#
# Nothing in the pipeline works without one of these: no match scores, no
# documents, no notification emails.

# Groq. Has a free tier, which is why it is the default.
# Key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile. Other options that support the
# JSON response format: openai/gpt-oss-120b, moonshotai/kimi-k2-instruct.
# If a model name is retired you will see a "model not found" error; change it
# here rather than in code. Current list: https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile

# xAI. Note that an xAI team with no credits returns 403 on EVERY call with
# "your newly created team doesn't have any credits or licenses yet", which is
# indistinguishable from a bad key until you read the message. Top up at
# https://console.x.ai before relying on this.
XAI_API_KEY=

# Optional. Defaults to grok-4.6.
# GROK_MODEL=grok-4.6

# Optional. Pins the provider instead of picking by which key is set.
# Valid values: groq, xai
# AI_PROVIDER=groq


# ---------------------------------------------------------------------------
# Tender discovery job (app/api/cron/discover-tenders)
# ---------------------------------------------------------------------------
# Server side only. None of these carry a NEXT_PUBLIC_ prefix, so none of them
# reach the browser. Keep it that way.

# Shared secret the scheduler presents, as "Authorization: Bearer <secret>" or
# "X-Cron-Secret: <secret>". The endpoint refuses every request when this is
# unset, so it fails closed rather than open. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Service role key, from Project Settings > API. Bypasses row level security,
# which the job needs because it reads every company and writes matches for all
# of them. Never expose this to a browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Minimum match_score to store, 0 to 100. Defaults to 60.
# TENDER_MATCH_THRESHOLD=60

# Optional. Comma separated source ids to run. Unset means every real source,
# plus "mock" outside production. Ids: ppip, county-nairobi, county-kiambu,
# county-nakuru, mock.
# TENDER_SOURCES=ppip,mock

# PPIP (tenders.go.ke) is a CSV import, not a scraper: the portal renders its
# listings client side, so there is no reliable markup to parse. Point one of
# these at an export. See lib/tender-sources/ppip.ts for the column format.
# PPIP_CSV_PATH=./data/ppip-export.csv
# PPIP_CSV_URL=

# Nakuru County ships disabled: its REST API is public and permitted, but the
# tender notices were not found in posts or media. Confirm the right collection
# before turning this on.
# TENDER_SOURCE_COUNTY_NAKURU=false


# ---------------------------------------------------------------------------
# Bid document drafting and notification (app/api/cron/draft-documents)
# ---------------------------------------------------------------------------
# Reuses CRON_SECRET, SUPABASE_SERVICE_ROLE_KEY and the AI provider key above.
# Documents go to the private "tender-documents" Storage bucket, created by
# migration 0006.

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. THE DOMAIN MUST BE ONE YOU OWN AND HAVE VERIFIED IN RESEND, or
# every send is rejected. A consumer mailbox can never work: gmail.com,
# outlook.com and the like are refused with "The <domain> domain is not
# verified", and there is no way to verify a domain you do not control.
# Add the domain at https://resend.com/domains, publish the DNS records it gives
# you, then use an address on it. A display name is fine:
#   RESEND_FROM_EMAIL=Quick Tenders <tenders@quicktenders.co.ke>
RESEND_FROM_EMAIL=

# Outside production, a sender on an unverifiable consumer domain falls back to
# Resend's shared onboarding@resend.dev so local runs are not silently broken.
# That sender only delivers to the address that owns the Resend account, so it is
# for development only and is never used when NODE_ENV=production.
# Set this to false to turn the fallback off and see the real rejection instead.
# RESEND_ALLOW_TEST_SENDER=false

# Where signup and payment alerts go. Defaults to quicktenders.ke@gmail.com.
# ADMIN_NOTIFICATION_EMAIL=

# The review link in the email is built from NEXT_PUBLIC_SITE_URL above, as
# <site url>/dashboard/tenders/<id>. Set NEXT_PUBLIC_SITE_URL to the real origin
# in production or the emails will link to localhost.

# Paystack (server key is private; public key is safe in the browser). Amount
# is in whole KES; the app converts it to cents for Paystack.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_CODE=
PAYSTACK_PLAN_AMOUNT_KES=2000

# TextSMS.co.ke. Sender IDs are capped at 11 characters.
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=1
TEXTSMS_SENDER_ID=QuickTndr
